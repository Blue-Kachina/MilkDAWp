+void ProjectM::SetPresetVariable(const std::string& name, double value)
+{
+    // Names are case-insensitive in the expression code, so store them that way.
+    std::string lowerName = name;
+    std::transform(lowerName.begin(), lowerName.end(), lowerName.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+
+    auto it = std::find_if(m_presetVariables.begin(), m_presetVariables.end(),
+                           [&lowerName](const std::pair<std::string, double>& var) { return var.first == lowerName; });
+    if (it == m_presetVariables.end())
+    {
+        m_presetVariables.emplace_back(lowerName, value);
+    }
+    else
+    {
+        it->second = value;
+    }
+
+    if (m_activePreset)
+    {
+        m_activePreset->SetExternalVariable(lowerName, value);
+    }
+    if (m_transitioningPreset)
+    {
+        m_transitioningPreset->SetExternalVariable(lowerName, value);
+    }
+}
