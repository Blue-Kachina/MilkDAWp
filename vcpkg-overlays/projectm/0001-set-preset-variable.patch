+void MilkdropPreset::SetExternalVariable(const std::string& name, double value)
+{
+    std::string lowerName = name;
+    std::transform(lowerName.begin(), lowerName.end(), lowerName.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+
+    auto it = std::find_if(m_externalVariables.begin(), m_externalVariables.end(),
+                           [&lowerName](const ExternalVariable& var) { return var.name == lowerName; });
+    if (it == m_externalVariables.end())
+    {
+        // Registering returns the same storage that code compiled before or after uses.
+        ExternalVariable var;
+        var.name = lowerName;
+        var.perFrame = projectm_eval_context_register_variable(m_perFrameContext.perFrameCodeContext, lowerName.c_str());
+        var.perPixel = projectm_eval_context_register_variable(m_perPixelContext.perPixelCodeContext, lowerName.c_str());
+        m_externalVariables.push_back(var);
+        it = std::prev(m_externalVariables.end());
+    }
+
+    it->value = static_cast<PRJM_EVAL_F>(value);
+
+    // Written right away as well, so per-frame init code sees values set before Initialize().
+    *it->perFrame = it->value;
+    *it->perPixel = it->value;
+}
+
+void MilkdropPreset::LoadExternalVariables()
+{
+    for (const auto& var : m_externalVariables)
+    {
+        *var.perFrame = var.value;
+        *var.perPixel = var.value;
+    }
+}
+
 void MilkdropPreset::PerFrameUpdate()
 {
     m_perFrameContext.LoadStateVariables(m_state);
     m_perPixelContext.LoadStateReadOnlyVariables(m_state, m_perFrameContext);
+    LoadExternalVariables();
 
     m_perFrameContext.ExecutePerFrameCode();
 
