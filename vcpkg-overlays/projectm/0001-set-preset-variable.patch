+/**
+ * @brief Sets a variable in the expression code of the active preset(s).
+ *
+ * The value is written into the preset's per-frame and per-vertex (per-pixel) code contexts
+ * before the per-frame code runs on every frame, so it persists across frames even if the
+ * preset's own code assigns the variable. During a soft transition both presets receive it,
+ * and every preset loaded later receives all values set so far, before its per-frame init
+ * code runs. Custom shape and waveform code does not see these variables.
+ *
+ * Meant for new variable names (e.g. "mdw_m1"). Setting a built-in variable such as "zoom"
+ * replaces the value the per-frame code starts from on each frame.
+ *
+ * Must be called from the thread that renders.
+ *
+ * MilkDAWp patch, not part of upstream projectM.
+ *
+ * @param instance The projectM instance handle.
+ * @param name The variable name. Case-insensitive. Ignored if NULL or empty.
+ * @param value The new value.
+ */
+PROJECTM_EXPORT void projectm_set_preset_variable(projectm_handle instance, const char* name, double value);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
