+void projectm_set_preset_variable(projectm_handle instance, const char* name, double value)
+{
+    if (name == nullptr || name[0] == '\0')
+    {
+        return;
+    }
+
+    auto projectMInstance = handle_to_instance(instance);
+    projectMInstance->SetPresetVariable(name, value);
+}
