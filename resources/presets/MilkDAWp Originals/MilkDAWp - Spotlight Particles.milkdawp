MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// MilkDAWp original preset (AGPL-3.0-or-later, written for this repo).
// Particles as flashlights: two spirals of dots streak through a feedback
// swirl and fold into a mandala, and the camera (sampler_camera) is seen
// only where they shine, in its own colours. The spirals turn once a bar
// (mdw_bar_phase), the swirl kicks on the beat (mdw_beat_phase), and the dots
// swell on onsets. Turn Colour up to see the particles themselves.
mdw_format=1
mdw_title=MilkDAWp - Spotlight Particles
mdw_tags=milkdawp,camera,particles,beat
mdw_renderer=projectm
mdw_ctl_1_name=Reveal
mdw_ctl_1_slot=macro1
mdw_ctl_1_mode=scale
mdw_ctl_1_target=q3
mdw_ctl_1_min=0.25
mdw_ctl_1_max=4
mdw_ctl_1_default=1
mdw_ctl_2_name=Glow
mdw_ctl_2_slot=macro2
mdw_ctl_2_mode=offset
mdw_ctl_2_target=q4
mdw_ctl_2_min=-0.35
mdw_ctl_2_max=1.15
mdw_ctl_2_default=0
mdw_ctl_3_name=Colour
mdw_ctl_3_slot=macro3
mdw_ctl_3_mode=offset
mdw_ctl_3_target=q6
mdw_ctl_3_min=-0.15
mdw_ctl_3_max=0.85
mdw_ctl_3_default=0
mdw_ctl_4_name=Segments
mdw_ctl_4_slot=macro4
mdw_ctl_4_mode=offset
mdw_ctl_4_target=q2
mdw_ctl_4_min=-4
mdw_ctl_4_max=6
mdw_ctl_4_default=0
fDecay=1.0
zoom=1.0
rot=0.0
warp=0.0
fWaveAlpha=0
ob_size=0
ib_size=0
mv_a=0
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.00000
wavecode_0_smoothing=0.50000
wavecode_0_r=1.000
wavecode_0_g=1.000
wavecode_0_b=1.000
wavecode_0_a=1.000
wave_0_per_point1=ang = sample * 6.2831853 * 6 + time * 0.35 + q1;
wave_0_per_point2=rad = 0.04 + 0.42 * sample + value1 * 0.12 * (1 + q5);
wave_0_per_point3=x = 0.5 + rad * cos(ang) * 0.5625;
wave_0_per_point4=y = 0.5 + rad * sin(ang);
wave_0_per_point5=r = 0.6 + 0.4 * sin(sample * 17 + time);
wave_0_per_point6=g = 0.6 + 0.4 * sin(sample * 23 + time * 1.3 + 2);
wave_0_per_point7=b = 0.6 + 0.4 * sin(sample * 29 + time * 0.7 + 4);
wave_0_per_point8=a = 0.9;
wavecode_1_enabled=1
wavecode_1_samples=384
wavecode_1_sep=0
wavecode_1_bSpectrum=1
wavecode_1_bUseDots=1
wavecode_1_bDrawThick=1
wavecode_1_bAdditive=1
wavecode_1_scaling=1.00000
wavecode_1_smoothing=0.50000
wavecode_1_r=1.000
wavecode_1_g=1.000
wavecode_1_b=1.000
wavecode_1_a=1.000
wave_1_per_point1=ang = -sample * 6.2831853 * 4 - time * 0.5 - q1 * 2;
wave_1_per_point2=rad = 0.46 - 0.4 * sample + value1 * 0.05;
wave_1_per_point3=x = 0.5 + rad * cos(ang) * 0.5625;
wave_1_per_point4=y = 0.5 + rad * sin(ang);
wave_1_per_point5=r = 1;
wave_1_per_point6=g = 0.7 + 0.3 * sin(sample * 11 + time);
wave_1_per_point7=b = 0.5;
wave_1_per_point8=a = 0.8;
per_frame_1=pulse = pow(1 - mdw_beat_phase, 4) * above(mdw_bpm, 0);
per_frame_2=q1 = mdw_bar_phase * 6.2831853;
per_frame_3=q2 = 6;
per_frame_4=q3 = 1.3;
per_frame_5=q4 = 0.35;
per_frame_6=q5 = mdw_onset;
per_frame_7=q6 = 0.15;
per_frame_8=zoom = 1.004 + 0.03 * pulse + (bass_att - 1) * 0.02;
per_frame_9=rot = 0.012 * sin(time * 0.27) + 0.01 * pulse;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_main, uv).xyz * 0.9 - 0.02;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  // Fold the particles into a mandala of q2 mirrored segments.
comp_4=`  float aspectX = texsize.x * texsize.w;
comp_5=`  float2 d = (uv - 0.5) * float2(aspectX, 1);
comp_6=`  float a = atan2(d.y, d.x);
comp_7=`  float seg = 6.2831853 / max(floor(q2 + 0.5), 1);
comp_8=`  a = abs(a - seg * floor(a / seg + 0.5));
comp_9=`  float2 fuv = 0.5 + float2(cos(a), sin(a)) * length(d) / float2(aspectX, 1);
comp_10=`  float3 vis = tex2D(sampler_main, fuv).xyz + GetBlur1(fuv) * saturate(q4);
comp_11=`  // The camera, where they shine, in its own colours.
comp_12=`  float lit = saturate(pow(max(vis.x, max(vis.y, vis.z)), 1.4) * q3);
comp_13=`  ret = tex2D(sampler_camera, uv).xyz * lit + vis * saturate(q6);
comp_14=`}
