MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// MilkDAWp original preset (AGPL-3.0-or-later, written for this repo).
// The opposite of Onset Edges: the flat regions, not the outlines. The camera
// (sampler_camera) posterized into a few brightness bands, each painted a
// bold colour, like a screen print, with the edges left as dark ink seams.
// The palette turns once a bar (mdw_bar_phase) and kicks on onsets.
mdw_format=1
mdw_title=MilkDAWp - Poster Pop
mdw_tags=milkdawp,camera,bar
mdw_renderer=projectm
mdw_ctl_1_name=Bands
mdw_ctl_1_slot=macro1
mdw_ctl_1_mode=offset
mdw_ctl_1_target=q1
mdw_ctl_1_min=-2
mdw_ctl_1_max=3
mdw_ctl_1_default=0
mdw_ctl_2_name=Ink
mdw_ctl_2_slot=macro2
mdw_ctl_2_mode=scale
mdw_ctl_2_target=q3
mdw_ctl_2_min=0
mdw_ctl_2_max=2.5
mdw_ctl_2_default=1
fDecay=1.0
zoom=1.0
rot=0.0
warp=0.0
fWaveAlpha=0
ob_size=0
ib_size=0
mv_a=0
per_frame_1=newonset = above(mdw_onset, lastonset + 0.3);
per_frame_2=lastonset = mdw_onset;
per_frame_3=kick = kick + 0.17 * newonset;
per_frame_4=kick = kick - int(kick);
per_frame_5=q1 = 4;
per_frame_6=q2 = mdw_bar_phase + kick + time * 0.02;
per_frame_7=q2 = q2 - int(q2);
per_frame_8=q3 = 1;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = float3(0, 0, 0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 w = float3(0.299, 0.587, 0.114);
comp_4=`  float2 px = texsize_camera.zw * 1.5;
comp_5=`  float3 c = (tex2D(sampler_fc_camera, uv).xyz * 2
comp_6=`              + tex2D(sampler_fc_camera, uv + float2(px.x, 0)).xyz + tex2D(sampler_fc_camera, uv - float2(px.x, 0)).xyz
comp_7=`              + tex2D(sampler_fc_camera, uv + float2(0, px.y)).xyz + tex2D(sampler_fc_camera, uv - float2(0, px.y)).xyz) / 6;
comp_8=`  float l = sqrt(saturate(dot(c, w)));  // on a gamma curve: a dim picture still spreads over the bands
comp_9=`  float bands = max(floor(q1 + 0.5), 2);
comp_10=`  float band = min(floor(l * bands), bands - 1);
comp_11=`  float3 col = 0.5 + 0.5 * cos(6.2831853 * (q2 + band * 0.618 + float3(0, 0.333, 0.667)));
comp_12=`  col = lerp(col, float3(1, 1, 1), band / (bands - 1) * 0.3);
comp_13=`  float2 e = px * 1.5;
comp_14=`  float lx = dot(tex2D(sampler_fc_camera, uv + float2(e.x, 0)).xyz - tex2D(sampler_fc_camera, uv - float2(e.x, 0)).xyz, w);
comp_15=`  float ly = dot(tex2D(sampler_fc_camera, uv + float2(0, e.y)).xyz - tex2D(sampler_fc_camera, uv - float2(0, e.y)).xyz, w);
comp_16=`  float ink = saturate((abs(lx) + abs(ly)) * 4 * q3 - 0.15);
comp_17=`  ret = col * (1 - ink);
comp_18=`}
