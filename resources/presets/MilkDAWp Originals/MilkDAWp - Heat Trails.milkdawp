MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
// MilkDAWp original preset (AGPL-3.0-or-later, written for this repo).
// A thermal camera for movement: wherever the camera (sampler_camera) sees
// something move, that spot heats up, then cools; the more recently it
// moved, the hotter its colour (black, blue, magenta, orange, yellow, white).
// Every onset (mdw_onset) cools it faster, so the trails pulse with the song.
// The feedback buffer is its memory, not a picture: red is last frame's
// camera brightness, green the heat. The composite shader paints the heat.
mdw_format=1
mdw_title=MilkDAWp - Heat Trails
mdw_tags=milkdawp,camera,motion
mdw_renderer=projectm
mdw_ctl_1_name=Threshold
mdw_ctl_1_slot=macro1
mdw_ctl_1_mode=offset
mdw_ctl_1_target=q1
mdw_ctl_1_min=-0.04
mdw_ctl_1_max=0.16
mdw_ctl_1_default=0
mdw_ctl_2_name=Cooling
mdw_ctl_2_slot=macro2
mdw_ctl_2_mode=scale
mdw_ctl_2_target=q2
mdw_ctl_2_min=0.2
mdw_ctl_2_max=3
mdw_ctl_2_default=1
mdw_ctl_3_name=Camera
mdw_ctl_3_slot=macro3
mdw_ctl_3_mode=offset
mdw_ctl_3_target=q3
mdw_ctl_3_min=-0.25
mdw_ctl_3_max=0.75
mdw_ctl_3_default=0
fDecay=1.0
zoom=1.0
rot=0.0
warp=0.0
fWaveAlpha=0
ob_size=0
ib_size=0
mv_a=0
per_frame_1=dt = if(above(mdw_dt, 0), mdw_dt, 0.0167);
per_frame_2=q1 = 0.05;
per_frame_3=q2 = 0.6 * dt * (1 + 2 * mdw_onset);
per_frame_4=q3 = 0.25;
warp_1=`shader_body
warp_2=`{
warp_3=`  // This frame's camera brightness, a little smoothed against sensor noise.
warp_4=`  float2 px = texsize_camera.zw * 2;
warp_5=`  float3 c = tex2D(sampler_fc_camera, uv_orig).xyz * 0.4
warp_6=`           + (tex2D(sampler_fc_camera, uv_orig + float2(px.x, 0)).xyz + tex2D(sampler_fc_camera, uv_orig - float2(px.x, 0)).xyz
warp_7=`            + tex2D(sampler_fc_camera, uv_orig + float2(0, px.y)).xyz + tex2D(sampler_fc_camera, uv_orig - float2(0, px.y)).xyz) * 0.15;
warp_8=`  float l = dot(c, float3(0.299, 0.587, 0.114));
warp_9=`  // Last frame's state, read where it was written (no warp, no filtering).
warp_10=`  float3 st = tex2D(sampler_pc_main, uv_orig).xyz;
warp_11=`  float motion = saturate((abs(l - st.x) - q1) * 6);
warp_12=`  // Cools by a fixed step: the buffer has 8 bits, so a fade by multiplying would stall.
warp_13=`  ret = float3(l, max(motion, st.y - q2), 0);
warp_14=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float h = tex2D(sampler_main, uv).y;
comp_4=`  h = max(h, GetBlur1(uv).y * 0.7);
comp_5=`  float3 heat = float3(saturate(h * 3 - 0.8),
comp_6=`                      saturate(h * 3 - 1.9),
comp_7=`                      saturate(h * 4) * saturate(2.4 - h * 3) + saturate(h * 5 - 4));
comp_8=`  float grey = dot(tex2D(sampler_fc_camera, uv).xyz, float3(0.299, 0.587, 0.114));
comp_9=`  ret = heat + grey * saturate(q3) * float3(0.35, 0.4, 0.55) * (1 - saturate(h * 2));
comp_10=`}
