{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-win",
      "displayName": "Developer (Windows)",
      "description": "Local dev on Windows, Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-win",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-win/vcpkg_installed",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-mac",
      "displayName": "Developer (macOS)",
      "description": "Local dev on macOS (Apple Silicon), Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-mac",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-mac/vcpkg_installed",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-linux",
      "displayName": "Developer (Linux)",
      "description": "Local dev on Linux (or the devcontainer), Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-linux/vcpkg_installed",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-win",
      "displayName": "CI (Windows)",
      "description": "CI build: all targets, tests on, single-config RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-win",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-ci-win/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-mac",
      "displayName": "CI (macOS)",
      "description": "CI build: all targets, tests on, single-config RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-mac",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-ci-mac/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI (Linux)",
      "description": "CI build: all targets, tests on, single-config RelWithDebInfo. Runs inside the devcontainer image.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-ci-linux/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-linux-asan",
      "displayName": "CI (Linux, ASan+UBSan)",
      "description": "Sanitizer job (0.4): core/engine tests only, Clang, no plugin/projectM",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-linux-asan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MILKDAWP_BUILD_PLUGIN": "OFF",
        "MILKDAWP_BUILD_APP": "OFF",
        "MILKDAWP_WITH_PROJECTM": "OFF",
        "MILKDAWP_SANITIZE_ADDRESS_UB": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-linux-tsan",
      "displayName": "CI (Linux, TSan)",
      "description": "Sanitizer job (0.4): AudioRing/Messages queue tests (Phase 1.1/1.2), Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-linux-tsan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MILKDAWP_BUILD_PLUGIN": "OFF",
        "MILKDAWP_BUILD_APP": "OFF",
        "MILKDAWP_WITH_PROJECTM": "OFF",
        "MILKDAWP_SANITIZE_THREAD": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-linux-rtsan",
      "displayName": "CI (Linux, RealtimeSanitizer)",
      "description": "Sanitizer job (0.4): [[clang::nonblocking]] functions on the audio callback path (Phase 3.1), Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci-linux-rtsan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MILKDAWP_BUILD_PLUGIN": "OFF",
        "MILKDAWP_BUILD_APP": "OFF",
        "MILKDAWP_WITH_PROJECTM": "OFF",
        "MILKDAWP_SANITIZE_REALTIME": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release-win",
      "displayName": "Release (Windows)",
      "description": "Packaging build: plugin + app, no tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-win",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-release-win/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Release",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_BUILD_APP": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "release-mac",
      "displayName": "Release (macOS)",
      "description": "Packaging build: plugin + app, universal binary, no tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-mac",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-release-mac/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_BUILD_APP": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release (Linux)",
      "description": "Packaging build: plugin + app, no tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release-linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-release-linux/vcpkg_installed",
        "CMAKE_BUILD_TYPE": "Release",
        "MILKDAWP_BUILD_PLUGIN": "ON",
        "MILKDAWP_BUILD_APP": "ON",
        "MILKDAWP_WITH_PROJECTM": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-win-Debug", "configurePreset": "dev-win", "configuration": "Debug" },
    { "name": "dev-win-Release", "configurePreset": "dev-win", "configuration": "Release" },
    { "name": "dev-mac-Debug", "configurePreset": "dev-mac", "configuration": "Debug" },
    { "name": "dev-mac-Release", "configurePreset": "dev-mac", "configuration": "Release" },
    { "name": "dev-linux-Debug", "configurePreset": "dev-linux", "configuration": "Debug" },
    { "name": "dev-linux-Release", "configurePreset": "dev-linux", "configuration": "Release" },
    { "name": "ci-win", "configurePreset": "ci-win" },
    { "name": "ci-mac", "configurePreset": "ci-mac" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-linux-asan", "configurePreset": "ci-linux-asan" },
    { "name": "ci-linux-tsan", "configurePreset": "ci-linux-tsan" },
    { "name": "ci-linux-rtsan", "configurePreset": "ci-linux-rtsan" },
    { "name": "release-win", "configurePreset": "release-win" },
    { "name": "release-mac", "configurePreset": "release-mac" },
    { "name": "release-linux", "configurePreset": "release-linux" }
  ],
  "testPresets": [
    {
      "name": "ci-win",
      "configurePreset": "ci-win",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-mac",
      "configurePreset": "ci-mac",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux-asan",
      "configurePreset": "ci-linux-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux-tsan",
      "configurePreset": "ci-linux-tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci-linux-rtsan",
      "configurePreset": "ci-linux-rtsan",
      "output": { "outputOnFailure": true }
